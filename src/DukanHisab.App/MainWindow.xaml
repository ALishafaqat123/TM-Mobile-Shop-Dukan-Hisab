<Window x:Class="DukanHisab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دکان حساب Next" Width="1380" Height="860" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}" FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="12,20">
                    <TextBlock Text="دکان حساب" Foreground="White" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Next Preview 0.1" Foreground="#7DE1C0" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <Button x:Name="NavDashboard" Style="{StaticResource SideButton}" Content="⌂  ڈیش بورڈ" Click="NavDashboard_Click"/>
                    <Button x:Name="NavJazz" Style="{StaticResource SideButton}" Content="●  جیزکیش ٹی ایم" Click="NavJazz_Click"/>
                    <Button x:Name="NavEasy" Style="{StaticResource SideButton}" Content="●  ایزی پیسہ شفاقت" Click="NavEasy_Click"/>
                    <Button x:Name="NavTanzeem" Style="{StaticResource SideButton}" Content="↔  تنظیم اِن / آؤٹ" Click="NavTanzeem_Click"/>
                    <Button x:Name="NavAccessories" Style="{StaticResource SideButton}" Content="▣  موبائل اسیسریز" Click="NavAccessories_Click"/>
                    <Button x:Name="NavClosing" Style="{StaticResource SideButton}" Content="✓  دن کا آخری حساب" Click="NavClosing_Click"/>
                    <Button x:Name="NavHistory" Style="{StaticResource SideButton}" Content="☷  روزانہ ہسٹری" Click="NavHistory_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                    <TextBlock Text="پرانی Smart PC v1.20 فائلیں صرف Read-only Import ہوتی ہیں۔" TextWrapping="Wrap" Foreground="#A7C3BA" FontSize="13"/>
                    <Button Content="v1.20 ڈیٹا کی Copy Import کریں" Click="ImportLegacy_Click" Background="#173C34" Foreground="White" BorderBrush="#315D53"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#E1E6E4" BorderThickness="0,0,0,1">
                <Grid Margin="18,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="ڈیش بورڈ" FontSize="27" FontWeight="Bold"/>
                        <TextBlock x:Name="StatusText" Text="تیار" Foreground="#557067" FontSize="13"/>
                    </StackPanel>
                    <DatePicker x:Name="DayPicker" Grid.Column="1" SelectedDateChanged="DayPicker_SelectedDateChanged" FontFamily="Segoe UI" FontSize="16" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="آج" Click="Today_Click" Background="#ECEFED"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="12">
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid Columns="5">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="گلہ — حسابی نقد"/><TextBlock x:Name="DashDrawer" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="جیزکیش"/><TextBlock x:Name="DashJazz" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ایزی پیسہ"/><TextBlock x:Name="DashEasy" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ون لوڈ"/><TextBlock x:Name="DashOneLoad" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="کمپیوٹر"/><TextBlock x:Name="DashComputer" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                        </UniformGrid>
                        <UniformGrid Columns="5">
                            <Border Style="{StaticResource Card}" Background="#E8F6F1"><StackPanel><TextBlock Text="حسابی موجود رقم"/><TextBlock x:Name="DashCurrentTotal" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold" Foreground="#087A5A"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Background="#FFF0E9"><StackPanel><TextBlock Text="آج کا حسابی منافع (Live)"/><TextBlock x:Name="DashLiveProfit" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold" Foreground="#B45723"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Background="#FFF8DC"><StackPanel><TextBlock Text="اصل منافع / Closing"/><TextBlock x:Name="DashClosingProfit" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="تنظیم اِن"/><TextBlock x:Name="DashTIn" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="تنظیم آؤٹ"/><TextBlock x:Name="DashTOut" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
                        </UniformGrid>
                        <UniformGrid Columns="5">
                            <Border Style="{StaticResource Card}" Background="#EEF6FF"><StackPanel><TextBlock Text="جیزکیش کمیشن"/><TextBlock x:Name="DashJazzCommission" FontFamily="Segoe UI" FontSize="21" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Background="#EFF8ED"><StackPanel><TextBlock Text="ایزی پیسہ کمیشن"/><TextBlock x:Name="DashEasyCommission" FontFamily="Segoe UI" FontSize="21" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Background="#F4EEFF"><StackPanel><TextBlock Text="تنظیم کمیشن"/><TextBlock x:Name="DashTanzeemCommission" FontFamily="Segoe UI" FontSize="21" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Background="#FFF5DF"><StackPanel><TextBlock Text="اسیسریز"/><TextBlock x:Name="DashAccessories" FontFamily="Segoe UI" FontSize="21" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Background="#F9ECEC"><StackPanel><TextBlock Text="غیر واضح فرق"/><TextBlock x:Name="DashUnexplained" FontFamily="Segoe UI" FontSize="21" FontWeight="Bold"/></StackPanel></Border>
                        </UniformGrid>
                        <Border Style="{StaticResource Card}">
                            <DockPanel><TextBlock DockPanel.Dock="Top" Text="آج کی تازہ انٹریز" FontSize="23" FontWeight="Bold" Margin="4"/>
                                <DataGrid x:Name="RecentGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="300" FlowDirection="RightToLeft" FontFamily="Jameel Noori Nastaleeq" FontSize="15">
                                    <DataGrid.Columns><DataGridTextColumn Header="وقت" Binding="{Binding Time}" Width="120"/><DataGridTextColumn Header="اکاؤنٹ" Binding="{Binding Account}" Width="180"/><DataGridTextColumn Header="قسم" Binding="{Binding Direction}" Width="80"/><DataGridTextColumn Header="رقم" Binding="{Binding Amount}" Width="110"/><DataGridTextColumn Header="کمیشن" Binding="{Binding Commission}" Width="90"/><DataGridTextColumn Header="دوسری طرف" Binding="{Binding Counter}" Width="190"/><DataGridTextColumn Header="نوٹ" Binding="{Binding Note}" Width="*"/></DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="AccountPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Columns="3"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Opening"/><TextBlock x:Name="AccountOpening" FontFamily="Segoe UI" FontSize="25" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ابھی"/><TextBlock x:Name="AccountCurrent" FontFamily="Segoe UI" FontSize="25" FontWeight="Bold" Foreground="#087A5A"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="انٹریز"/><TextBlock x:Name="AccountCount" FontFamily="Segoe UI" FontSize="25" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
                    <Border Grid.Row="1" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="قسم"/><ComboBox x:Name="AccountDirection"><ComboBoxItem Content="اِن / وصول" Tag="in"/><ComboBoxItem Content="آؤٹ / سینڈ" Tag="out"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="رقم"/><TextBox x:Name="AccountAmount"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="دوسری طرف"/><ComboBox x:Name="AccountCounter"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="کمیشن (خالی = Auto)"/><TextBox x:Name="AccountCommission"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="نوٹ"/><TextBox x:Name="AccountNote"/></StackPanel><StackPanel Grid.Column="5" VerticalAlignment="Bottom" Orientation="Horizontal"><Button Content="محفوظ کریں" Click="SaveAccountTransaction_Click" Background="#0A7A5B" Foreground="White"/><Button Content="منتخب حذف" Click="DeleteSelectedTransaction_Click" Background="#A53F3F" Foreground="White"/></StackPanel></Grid></Border>
                    <DataGrid x:Name="AccountGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" FontFamily="Jameel Noori Nastaleeq" FontSize="15"><DataGrid.Columns><DataGridTextColumn Header="وقت" Binding="{Binding Time}" Width="120"/><DataGridTextColumn Header="قسم" Binding="{Binding Direction}" Width="90"/><DataGridTextColumn Header="رقم" Binding="{Binding Amount}" Width="120"/><DataGridTextColumn Header="کمیشن" Binding="{Binding Commission}" Width="90"/><DataGridTextColumn Header="دوسری طرف" Binding="{Binding Counter}" Width="210"/><DataGridTextColumn Header="نوٹ" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid>
                </Grid>
                <Grid x:Name="TanzeemPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><UniformGrid Columns="2"><Border Style="{StaticResource Card}" Background="#EAF8F2"><StackPanel><TextBlock Text="تنظیم اِن — دکان سے تنظیم کے پاس"/><TextBlock x:Name="TInTotal" FontFamily="Segoe UI" FontSize="27" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}" Background="#FFF0E9"><StackPanel><TextBlock Text="تنظیم آؤٹ — تنظیم سے دکان میں"/><TextBlock x:Name="TOutTotal" FontFamily="Segoe UI" FontSize="27" FontWeight="Bold"/></StackPanel></Border></UniformGrid><Border Grid.Row="1" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="قسم"/><ComboBox x:Name="TanzeemType"><ComboBoxItem Content="تنظیم اِن" Tag="in"/><ComboBoxItem Content="تنظیم آؤٹ" Tag="out"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="رقم"/><TextBox x:Name="TanzeemAmount"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="دکان کا اکاؤنٹ"/><ComboBox x:Name="TanzeemAccount"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="کمیشن (خالی = Auto)"/><TextBox x:Name="TanzeemCommission"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="نوٹ"/><TextBox x:Name="TanzeemNote"/></StackPanel><StackPanel Grid.Column="5" VerticalAlignment="Bottom" Orientation="Horizontal"><Button Content="محفوظ کریں" Click="SaveTanzeem_Click" Background="#0A7A5B" Foreground="White"/><Button Content="منتخب حذف" Click="DeleteSelectedTanzeem_Click" Background="#A53F3F" Foreground="White"/></StackPanel></Grid></Border><DataGrid x:Name="TanzeemGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" FontFamily="Jameel Noori Nastaleeq" FontSize="15"><DataGrid.Columns><DataGridTextColumn Header="وقت" Binding="{Binding Time}" Width="120"/><DataGridTextColumn Header="قسم" Binding="{Binding Direction}" Width="110"/><DataGridTextColumn Header="رقم" Binding="{Binding Amount}" Width="120"/><DataGridTextColumn Header="کمیشن" Binding="{Binding Commission}" Width="90"/><DataGridTextColumn Header="اصل اکاؤنٹ" Binding="{Binding Account}" Width="190"/><DataGridTextColumn Header="نوٹ" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid></Grid>
                <Grid x:Name="AccessoriesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><UniformGrid Columns="3"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="فروخت"/><TextBlock x:Name="AccSales" FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="واپسی"/><TextBlock x:Name="AccReturns" FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}" Background="#FFF5DF"><StackPanel><TextBlock Text="خالص آمدن"/><TextBlock x:Name="AccNet" FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"/></StackPanel></Border></UniformGrid><Border Grid.Row="1" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="قسم"/><ComboBox x:Name="AccType"><ComboBoxItem Content="فروخت" Tag="sale"/><ComboBoxItem Content="واپسی" Tag="return"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="رقم"/><TextBox x:Name="AccAmount"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="نوٹ / چیز"/><TextBox x:Name="AccNote"/></StackPanel><StackPanel Grid.Column="3" VerticalAlignment="Bottom" Orientation="Horizontal"><Button Content="محفوظ کریں" Click="SaveAccessory_Click" Background="#0A7A5B" Foreground="White"/><Button Content="منتخب حذف" Click="DeleteSelectedAccessory_Click" Background="#A53F3F" Foreground="White"/></StackPanel></Grid></Border><DataGrid x:Name="AccGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" FontFamily="Jameel Noori Nastaleeq" FontSize="15"><DataGrid.Columns><DataGridTextColumn Header="وقت" Binding="{Binding Time}" Width="130"/><DataGridTextColumn Header="قسم" Binding="{Binding Direction}" Width="110"/><DataGridTextColumn Header="رقم" Binding="{Binding Amount}" Width="130"/><DataGridTextColumn Header="نوٹ" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid></Grid>
                <ScrollViewer x:Name="ClosingPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}" Background="#FFF8DC"><TextBlock Text="دن کے آخر میں اصل موجود رقمیں درج کریں۔ یہی Final Profit کی آخری سچائی ہے؛ JazzCash/Easypaisa کی تمام روزانہ انٹریاں لکھنا لازمی نہیں، لیکن تنظیم اِن/آؤٹ لازمی ہیں۔" TextWrapping="Wrap" FontSize="20"/></Border><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Grid.Column="0" Text="اکاؤنٹ" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="Opening" FontWeight="Bold"/><TextBlock Grid.Column="2" Text="حسابی ابھی" FontWeight="Bold"/><TextBlock Grid.Column="3" Text="اصل Closing" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="کمپیوٹر کیش"/><TextBlock x:Name="CloseOpenComputer" Grid.Row="1" Grid.Column="1" FontFamily="Segoe UI"/><TextBlock x:Name="CloseBookComputer" Grid.Row="1" Grid.Column="2" FontFamily="Segoe UI"/><TextBox x:Name="CloseComputer" Grid.Row="1" Grid.Column="3"/><TextBlock Grid.Row="2" Text="دوسرے گلے کی نقد"/><TextBlock x:Name="CloseOpenDrawer" Grid.Row="2" Grid.Column="1" FontFamily="Segoe UI"/><TextBlock x:Name="CloseBookDrawer" Grid.Row="2" Grid.Column="2" FontFamily="Segoe UI"/><TextBox x:Name="CloseDrawer" Grid.Row="2" Grid.Column="3"/><TextBlock Grid.Row="3" Text="جیزکیش ٹی ایم موبائل"/><TextBlock x:Name="CloseOpenJazz" Grid.Row="3" Grid.Column="1" FontFamily="Segoe UI"/><TextBlock x:Name="CloseBookJazz" Grid.Row="3" Grid.Column="2" FontFamily="Segoe UI"/><TextBox x:Name="CloseJazz" Grid.Row="3" Grid.Column="3"/><TextBlock Grid.Row="4" Text="ایزی پیسہ شفاقت"/><TextBlock x:Name="CloseOpenEasy" Grid.Row="4" Grid.Column="1" FontFamily="Segoe UI"/><TextBlock x:Name="CloseBookEasy" Grid.Row="4" Grid.Column="2" FontFamily="Segoe UI"/><TextBox x:Name="CloseEasy" Grid.Row="4" Grid.Column="3"/><TextBlock Grid.Row="5" Text="ون لوڈ"/><TextBlock x:Name="CloseOpenOneLoad" Grid.Row="5" Grid.Column="1" FontFamily="Segoe UI"/><TextBlock x:Name="CloseBookOneLoad" Grid.Row="5" Grid.Column="2" FontFamily="Segoe UI"/><TextBox x:Name="CloseOneLoad" Grid.Row="5" Grid.Column="3"/></Grid></Border><UniformGrid Columns="5"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Opening Total"/><TextBlock x:Name="CloseOpeningTotal" FontFamily="Segoe UI" FontSize="23" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Closing Total"/><TextBlock x:Name="CloseActualTotal" FontFamily="Segoe UI" FontSize="23" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="تنظیم اِن"/><TextBlock x:Name="CloseTIn" FontFamily="Segoe UI" FontSize="23" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="تنظیم آؤٹ"/><TextBlock x:Name="CloseTOut" FontFamily="Segoe UI" FontSize="23" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}" Background="#FFF0E9"><StackPanel><TextBlock Text="اصل منافع"/><TextBlock x:Name="CloseProfit" FontFamily="Segoe UI" FontSize="25" FontWeight="Bold"/></StackPanel></Border></UniformGrid><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Closing محفوظ کریں" Click="SaveClosing_Click" Background="#DDAA34"/><TextBlock x:Name="ClosingMessage" VerticalAlignment="Center" Margin="12" Foreground="#6B5A36"/></StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="درستی / ترمیم کی ہسٹری" FontSize="23" FontWeight="Bold"/><DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="220" FontFamily="Jameel Noori Nastaleeq" FontSize="14"><DataGrid.Columns><DataGridTextColumn Header="وقت" Binding="{Binding At}" Width="190"/><DataGridTextColumn Header="درستی" Binding="{Binding Summary}" Width="250"/><DataGridTextColumn Header="پہلے" Binding="{Binding Before}" Width="*"/><DataGridTextColumn Header="بعد" Binding="{Binding After}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></ScrollViewer>
                <Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="محفوظ دن" FontSize="23" FontWeight="Bold"/><ListBox x:Name="HistoryDates" SelectionChanged="HistoryDates_SelectionChanged" FontFamily="Segoe UI" FontSize="16"/></DockPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="HistorySummary" TextWrapping="Wrap" FontSize="19"/></ScrollViewer></Border></Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
